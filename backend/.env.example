SECRET_KEY=replace-with-at-least-32-char-random-secret-key
JWT_SECRET_KEY=replace-with-at-least-32-char-random-jwt-secret
DATABASE_URL=sqlite:///rse_analytics.db
INGESTION_INTERVAL_SECONDS=60
MAX_POSTS_PER_SOURCE=20
CORS_ORIGINS=*
ENABLE_PROMETHEUS=true
ENABLE_MOCK_DATA=false
LOCAL_BERT_MODEL_PATH=models/bert_sentiment
LSTM_MODEL_PATH=models/lstm_trend.pt
LOCAL_DATASET_PATH=data/social_posts.csv
USE_LIVE_SOURCES=true
ENABLE_GEMINI=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=20
ENABLE_LSTM_MODEL=true
LSTM_SEQUENCE_LENGTH=6
LSTM_EPOCHS=25
LSTM_HIDDEN_SIZE=32
LSTM_LEARNING_RATE=0.01

# Optional for live Twitter source
TWITTER_BEARER_TOKEN=

# Optional for YouTube comments source
YOUTUBE_API_KEY=

# Optional for Google Trends via pytrends
ENABLE_PYTRENDS=true
PYTRENDS_HL=en-US
PYTRENDS_GEO=US
PYTRENDS_TIMEFRAME=today 12-m
PYTRENDS_TZ=360
